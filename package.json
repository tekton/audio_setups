{
  "name": "audio-gear-layout",
  "version": "1.0.0",
  "description": "Audio gear layout - plan and visualize a stereo/hi-fi chain",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config frontend/tests/jest.config.js frontend/tests/",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config frontend/tests/jest.config.js --watch frontend/tests/",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config frontend/tests/jest.config.js --coverage frontend/tests/",
    "test:e2e": "playwright test",
    "build:local": "node scripts/build-local.js",
    "preview:local": "npm run build:local && python3 -m http.server 4174 --directory dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^30.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
